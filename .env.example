# Copy to .env for docker compose. Compose reads these for interpolation.
PORT=25562
SESSION_TTL_HOURS=168
RECONNECT_GRACE_SECONDS=120
# 铜铃冷却（秒），双方共用
RING_COOLDOWN_SECONDS=2.5
# Release a Yixin process when its AI game has had no active browser for this long.
AI_IDLE_RELEASE_SECONDS=300

# Set true only when the public site is served over HTTPS.
COOKIE_SECURE=false
# Set true behind Caddy/Nginx so rate limiting sees the real client IP.
TRUST_PROXY=false
CORS_ORIGINS=

# Yixin is not bundled. Example for a native Windows host:
# YIXIN_ENGINE_PATH=C:\Yixin\Yixin2018.exe
# YIXIN_LAUNCHER=
# Example for Linux + Wine inside a custom image:
# YIXIN_ENGINE_PATH=/engines/Yixin2018.exe
# YIXIN_LAUNCHER=wine
YIXIN_ENGINE_PATH=
YIXIN_LAUNCHER=
YIXIN_PROTOCOL=gomocup
YIXIN_TIMEOUT_TURN_MS=5000
YIXIN_TIMEOUT_MATCH_MS=300000
YIXIN_MAX_SESSIONS=8

# Host directory that contains the engine binary, mounted read-only.
YIXIN_ENGINE_DIR=./engines

# 网络电台曲库。留空则用仓库根下的 radio/；也可以指向已有的音乐目录：
# RADIO_DIR=D:\Music
RADIO_DIR=
# Compose 用这个变量做宿主机目录挂载（容器内固定为 /radio，只读）。
RADIO_DIR_HOST=./radio
