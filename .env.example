# 复制为 .env 后按需修改。docker compose 也读取这些变量做插值。

PORT=25562
SESSION_TTL_HOURS=168
RECONNECT_GRACE_SECONDS=120

# 铜铃冷却（秒），按对局计算、双方共用。0 = 不限制，可连按（含连点器）。
RING_COOLDOWN_SECONDS=0

# 约战邀请的有效期（秒）。
CHALLENGE_TTL_SECONDS=30

# 仅在公网站点走 HTTPS 时设为 true。
COOKIE_SECURE=false
# 在 Caddy / Nginx 反代之后设为 true，限流才能看到真实客户端 IP。
TRUST_PROXY=false
# 允许的跨域来源，逗号分隔；同源部署可留空。
CORS_ORIGINS=

# 网络电台曲库。留空则用仓库根下的 radio/；也可指向已有音乐目录：
# RADIO_DIR=D:\Music
RADIO_DIR=
# compose 用这个变量做宿主机目录挂载（容器内固定为 /radio，只读）。
RADIO_DIR_HOST=./radio
