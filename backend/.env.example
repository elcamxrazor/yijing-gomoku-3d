# External executable only. Never place Yixin binaries in this project.
# Yixin is licensed for non-commercial use only; commercial use requires the author's written permission.
YIXIN_ENGINE_PATH=
# Empty for native execution, or "wine" on supported Linux hosts.
YIXIN_LAUNCHER=
YIXIN_PROTOCOL=gomocup
YIXIN_TIMEOUT_TURN_MS=5000
YIXIN_TIMEOUT_MATCH_MS=300000
YIXIN_MAX_SESSIONS=8
DATABASE_URL=sqlite:///./data/gomoku.db
SESSION_TTL_HOURS=168
RECONNECT_GRACE_SECONDS=120
# Release a Yixin process when its AI game has had no active browser for this long.
AI_IDLE_RELEASE_SECONDS=300
CORS_ORIGINS=http://localhost:25562,http://127.0.0.1:25562
COOKIE_SECURE=false
# Set true only behind a trusted reverse proxy; it enables X-Forwarded-For.
TRUST_PROXY=false
FRONTEND_DIST=
PORT=25562
