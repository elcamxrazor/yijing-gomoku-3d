# 复制为 backend/.env 后按需修改。

DATABASE_URL=sqlite:///./data/gomoku.db
SESSION_TTL_HOURS=168
RECONNECT_GRACE_SECONDS=120

# 铜铃冷却（秒），按对局计算、双方共用。0 = 不限制，可连按（含连点器）。
RING_COOLDOWN_SECONDS=0

# 约战邀请的有效期（秒）。
CHALLENGE_TTL_SECONDS=30

# 开发期前端地址；同源部署可留空。
CORS_ORIGINS=http://localhost:25562,http://127.0.0.1:25562

# 仅 HTTPS 站点设为 true。
COOKIE_SECURE=false
# 在受信反向代理之后设为 true，启用 X-Forwarded-For。
TRUST_PROXY=false

# 自定义前端 dist 目录；留空则自动查找 frontend/dist。
FRONTEND_DIST=
PORT=25562

# 网络电台曲库目录。留空则用仓库根下的 radio/。
RADIO_DIR=
